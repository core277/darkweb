rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function myData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return isSignedIn() && myData().role == 'admin';
    }
    function isNotBanned() {
      return isSignedIn() && myData().banned == false;
    }
    function serverData(sid) {
      return get(/databases/$(database)/documents/servers/$(sid)).data;
    }
    function isMember(sid) {
      return isSignedIn() && request.auth.uid in serverData(sid).memberIds;
    }
    function isOwner(sid) {
      return isSignedIn() && serverData(sid).ownerUid == request.auth.uid;
    }
    // "HOME" is the server everyone is in automatically and can't leave.
    function isHome(sid) {
      return sid == 'HOME';
    }
    // Site admins can see and manage every server; owners manage their own.
    function canAccess(sid) {
      return isAdmin() || isHome(sid) || isMember(sid);
    }
    function canManage(sid) {
      return isAdmin() || isOwner(sid);
    }
    // Role permissions are denormalised onto the server doc as memberPerms: { uid: [perm, ...] }.
    function hasPerm(sid, p) {
      let d = serverData(sid);
      return isSignedIn()
          && ('memberPerms' in d)
          && (request.auth.uid in d.memberPerms)
          && (p in d.memberPerms[request.auth.uid]);
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.role == 'member'
                    && request.resource.data.banned == false;
      allow update: if isSignedIn() && (
                      isAdmin() ||
                      (request.auth.uid == userId
                        && request.resource.data.role == resource.data.role
                        && request.resource.data.banned == resource.data.banned)
                    );
      allow delete: if isAdmin();
    }

    // Direct messages: document id is the two uids sorted and joined with "_".
    // Only the two participants can read them - not even site admins.
    match /dms/{dmId} {
      function isParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participants;
      }
      function dmIdFor(p) {
        return p[0] < p[1] ? p[0] + '_' + p[1] : p[1] + '_' + p[0];
      }
      allow get: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participants);
      allow list: if isParticipant();
      allow create: if isNotBanned()
                    && request.resource.data.participants.size() == 2
                    && request.auth.uid in request.resource.data.participants
                    && dmId == dmIdFor(request.resource.data.participants);
      allow update: if isParticipant() && request.resource.data.participants == resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        function canUseDm() {
          return isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/dms/$(dmId)).data.participants;
        }
        allow read: if canUseDm();
        allow create: if canUseDm() && isNotBanned() && request.resource.data.uid == request.auth.uid;
        allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
        allow update: if false;
      }
    }

    // @mention notifications: fanned out on write to the recipient's own subcollection so a
    // client only ever watches its own pings, no cross-server listeners or indexes needed.
    match /pings/{uid}/items/{itemId} {
      allow read, delete: if isSignedIn() && request.auth.uid == uid;
      allow create: if isNotBanned()
                    && request.resource.data.fromUid == request.auth.uid
                    && canAccess(request.resource.data.serverId);
      allow update: if false;
    }

    match /servers/{serverId} {
      function onlyMembersChanged() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']);
      }
      function addsSelf() {
        return !(request.auth.uid in resource.data.memberIds)
            && request.auth.uid in request.resource.data.memberIds
            && request.resource.data.memberIds.hasAll(resource.data.memberIds)
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1;
      }
      function removesSelf() {
        return request.auth.uid in resource.data.memberIds
            && !(request.auth.uid in request.resource.data.memberIds)
            && resource.data.memberIds.hasAll(request.resource.data.memberIds)
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1;
      }

      // Anyone signed in can fetch a single server by its invite code (the document id);
      // listing is limited to your own servers unless you're a site admin.
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (isAdmin() || request.auth.uid in resource.data.memberIds);
      allow create: if isNotBanned()
                    && (!isHome(serverId) || isAdmin())
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.memberIds == [request.auth.uid]
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 40;
      allow update: if isAdmin()
                    || (resource.data.ownerUid == request.auth.uid
                        && request.resource.data.ownerUid == resource.data.ownerUid)
                    || (isNotBanned() && onlyMembersChanged() && (addsSelf() || (removesSelf() && !isHome(serverId))));
      allow delete: if isAdmin() || (resource.data.ownerUid == request.auth.uid && !isHome(serverId));

      match /channels/{channelId} {
        allow read: if canAccess(serverId);
        allow create, update, delete: if canManage(serverId) || hasPerm(serverId, 'manageChannels');

        match /messages/{messageId} {
          allow read: if canAccess(serverId);
          allow create: if canAccess(serverId) && isNotBanned() && request.resource.data.uid == request.auth.uid;
          allow delete: if canManage(serverId) || hasPerm(serverId, 'manageMessages')
                        || (isSignedIn() && resource.data.uid == request.auth.uid);
          allow update: if false;
        }

        // Forum channels: posts (threads) with their own message lists.
        match /posts/{postId} {
          allow read: if canAccess(serverId);
          allow create: if canAccess(serverId) && isNotBanned() && request.resource.data.uid == request.auth.uid;
          allow update: if canAccess(serverId) && isNotBanned()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActivity', 'messageCount']);
          allow delete: if canManage(serverId) || hasPerm(serverId, 'manageMessages')
                        || (isSignedIn() && resource.data.uid == request.auth.uid);

          match /messages/{messageId} {
            allow read: if canAccess(serverId);
            allow create: if canAccess(serverId) && isNotBanned() && request.resource.data.uid == request.auth.uid;
            allow delete: if canManage(serverId) || hasPerm(serverId, 'manageMessages')
                          || (isSignedIn() && resource.data.uid == request.auth.uid);
            allow update: if false;
          }
        }
      }

      match /voiceChannels/{channelId}/participants/{userId} {
        allow read: if canAccess(serverId);
        allow create, delete: if canAccess(serverId) && request.auth.uid == userId && isNotBanned();
        allow update: if false;
      }

      match /voiceChannels/{channelId}/signals/{signalId} {
        allow read: if canAccess(serverId);
        allow create: if canAccess(serverId) && request.resource.data.from == request.auth.uid;
        allow delete: if isSignedIn() && resource.data.to == request.auth.uid;
        allow update: if false;
      }
    }
  }
}
